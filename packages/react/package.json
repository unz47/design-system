{
  "name": "@frost-ui/react",
  "version": "0.0.0",
  "description": "Aurora(Frost / Silver)の React コンポーネント 36 個。Base UI + Tailwind v4。TypeScript ソースのまま配布する",
  "license": "MIT",
  "author": "Tomoya Saito",
  "homepage": "https://github.com/unz47/design-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unz47/design-system.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/unz47/design-system/issues"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "tailwindcss",
    "base-ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/ui.css",
    "./atoms/*": "./src/components/atoms/*/index.ts",
    "./molecules/*": "./src/components/molecules/*/index.ts",
    "./organisms/*": "./src/components/organisms/*/index.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "tsc --noEmit && eslint ."
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@frost-ui/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@frost-ui/eslint-config": "workspace:*",
    "@frost-ui/tsconfig": "workspace:*",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.0"
  }
}
