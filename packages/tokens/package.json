{
  "name": "@frost-ui/tokens",
  "version": "0.0.0",
  "description": "Aurora(Frost / Silver)デザイントークン。CSS 変数・Tailwind v4 テーマ・NativeWind preset・JS オブジェクトを配布する",
  "license": "MIT",
  "author": "Tomoya Saito",
  "homepage": "https://github.com/unz47/design-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unz47/design-system.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/unz47/design-system/issues"
  },
  "keywords": [
    "design-tokens",
    "tailwindcss",
    "css-variables",
    "nativewind",
    "style-dictionary"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./theme.css": "./dist/css/theme.css",
    "./variables.css": "./dist/css/variables.css",
    "./native/preset": "./dist/native/preset.js",
    "./native/global.css": "./dist/native/global.css",
    "./figma": "./dist/figma/variables.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node style-dictionary.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "tsc --noEmit && eslint ."
  },
  "devDependencies": {
    "style-dictionary": "^5.1.0",
    "culori": "^4.0.1",
    "@frost-ui/tsconfig": "workspace:*",
    "@frost-ui/eslint-config": "workspace:*",
    "eslint": "^9.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
