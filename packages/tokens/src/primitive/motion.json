{
  "motion": {
    "duration": {
      "fast":   { "$type": "duration", "$value": "120ms" },
      "normal": { "$type": "duration", "$value": "200ms" },
      "slow":   { "$type": "duration", "$value": "320ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] },
      "entrance": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] },
      "exit":     { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] },
      "spring":   { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1] }
    }
  }
}
