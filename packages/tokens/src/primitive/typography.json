{
  "fontFamily": {
    "sans": { "$type": "fontFamily", "$value": ["Geist", "ui-sans-serif", "system-ui", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "SFMono-Regular", "monospace"] }
  },
  "fontWeight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold": { "$type": "fontWeight", "$value": 700 }
  },
  "text": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "48px",
        "fontWeight": "{fontWeight.semibold}",
        "lineHeight": "1.1",
        "letterSpacing": "-0.02em"
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "32px",
        "fontWeight": "{fontWeight.semibold}",
        "lineHeight": "1.2",
        "letterSpacing": "-0.01em"
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "24px",
        "fontWeight": "{fontWeight.semibold}",
        "lineHeight": "1.3",
        "letterSpacing": "-0.01em"
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "18px",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "1.6",
        "letterSpacing": "0"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "16px",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "1.6",
        "letterSpacing": "0"
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "14px",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "14px",
        "fontWeight": "{fontWeight.medium}",
        "lineHeight": "1.4",
        "letterSpacing": "0"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.sans}",
        "fontSize": "12px",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "1.4",
        "letterSpacing": "0.01em"
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{fontFamily.mono}",
        "fontSize": "14px",
        "fontWeight": "{fontWeight.regular}",
        "lineHeight": "1.6",
        "letterSpacing": "0"
      }
    }
  }
}
