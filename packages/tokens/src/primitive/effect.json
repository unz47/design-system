{
  "effect": {
    "metallic": {
      "gradient": { "$type": "string", "$value": "linear-gradient(135deg, {color.neutral.300} 0%, {color.neutral.100} 25%, {color.neutral.400} 50%, {color.neutral.100} 75%, {color.neutral.300} 100%)" }
    },
    "frost": {
      "blur": { "$type": "dimension", "$value": "18px" },
      "saturate": { "$type": "string", "$value": "120%" }
    },
    "glow": {
      "opacity": { "$type": "number", "$value": 0.3 },
      "blur": { "$type": "dimension", "$value": "32px" }
    },
    "grain": {
      "opacity": { "$type": "number", "$value": 0.04 }
    }
  }
}
