        "border": { "$type": "color", "$value": "{color.success.border-light}" }
      },
      "danger": {
        "solid": { "$type": "color", "$value": "{color.danger.solid-strong}" },
        "subtle-bg": { "$type": "color", "$value": "{color.danger.subtle-bg-light}" },
        "border": { "$type": "color", "$value": "{color.danger.border-light}" }
      },
      "warning": {
        "solid": { "$type": "color", "$value": "{color.warning.solid-strong}" },
        "subtle-bg": { "$type": "color", "$value": "{color.warning.subtle-bg-light}" },
        "border": { "$type": "color", "$value": "{color.warning.border-light}" }
      },
      "info": {
        "solid": { "$type": "color", "$value": "{color.info.solid-strong}" },
        "subtle-bg": { "$type": "color", "$value": "{color.info.subtle-bg-light}" },
        "border": { "$type": "color", "$value": "{color.info.border-light}" }
      }
