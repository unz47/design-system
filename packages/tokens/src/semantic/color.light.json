{
  "color": {
    "bg": {
      "base": { "$type": "color", "$value": "{color.neutral.100}" },
      "surface": { "$type": "color", "$value": "{color.neutral.50}" },
      "raised": { "$type": "color", "$value": "{color.neutral.0}" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "{color.neutral.200}" },
      "default": { "$type": "color", "$value": "{color.neutral.300}" },
      "strong": { "$type": "color", "$value": "{color.neutral.400}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.neutral.950}" },
      "secondary": { "$type": "color", "$value": "{color.neutral.700}" },
      "muted": { "$type": "color", "$value": "{color.neutral.500}" }
    },
    "accent": {
      "default": { "$type": "color", "$value": "{color.frost.800}" },
      "dim": { "$type": "color", "$value": "{color.frost.600}" },
      "glow": { "$type": "color", "$value": "{color.frost.200}" }
    },
    "accent-alt": {
      "default": { "$type": "color", "$value": "{color.plum.500}" }
    },
    "on-accent": { "$type": "color", "$value": "{color.neutral.0}" },
    "focus-ring": { "$type": "color", "$value": "{color.frost.800}" },
    "status": {
      "success": {
        "solid": { "$type": "color", "$value": "{color.success.solid-strong}" },
