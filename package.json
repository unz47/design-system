{
  "name": "aurora-design-system",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "verify": "turbo verify",
    "clean": "turbo clean",
    "tokens": "turbo build --filter=@unz47/tokens",
    "tokens:check": "pnpm tokens && git diff --exit-code -- packages/tokens/dist"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.9.0"
  }
}
